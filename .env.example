# Clés API de l'exchange (uniquement pour mode: live).
# Ne commit JAMAIS le fichier .env. Crée des clés SANS droit de retrait.
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
# Revolut X utilise une clé privée Ed25519 (contenu PEM) au lieu d'un secret.
EXCHANGE_PRIVATE_KEY=

# Sécurité : le mode live refuse de démarrer sans cette ligne à "oui".
LIVE_TRADING_CONFIRMED=non

# Notifications Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
